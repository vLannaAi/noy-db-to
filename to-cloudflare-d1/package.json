{
  "name": "@noy-db/to-cloudflare-d1",
  "version": "0.2.0-pre.32",
  "description": "Cloudflare D1 adapter for noy-db — SQLite at the edge, running inside Cloudflare Workers. Accepts a D1Database binding and speaks the noy-db store contract via D1's prepare/bind API.",
  "license": "MIT",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/vLannaAi/noy-db-to/tree/main/to-cloudflare-d1#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vLannaAi/noy-db-to.git"
  },
  "bugs": {
    "url": "https://github.com/vLannaAi/noy-db-to/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.3.0-pre.1"
  },
  "devDependencies": {
    "@noy-db/hub": "0.3.0-pre.7",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "noy-db",
    "to-cloudflare-d1",
    "cloudflare",
    "d1",
    "sqlite",
    "edge",
    "workers"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
